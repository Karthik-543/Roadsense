# RoadSense AI Environment Configuration Template
# Copy this file to .env and provide your secure OpenAI API key.

# OpenAI LLM Configuration (Server-Side Only for RAG Subsystem)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/RoadSense

# Google Routes API Key (Backend Gateway Only)
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
