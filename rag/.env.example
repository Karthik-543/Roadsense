# RoadSense AI RAG Subsystem Environment Configuration Template

# LLM Provider Configuration (options: auto, openai, local)
LLM_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini

# Embedding Model & Vectorstore Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTORSTORE_DIR=vectorstore/chroma
CHROMA_COLLECTION=roadsense_knowledge

# External Context API Credentials (Optional)
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://api.weatherapi.com/v1/current.json

TRAFFIC_API_KEY=your_traffic_api_key_here
TRAFFIC_API_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData

OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# RAG Threshold Defaults
DEFAULT_MIN_SCORE=0.50
DEFAULT_TOP_K=5
